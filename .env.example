# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/humhelp

# Flask JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Keys (Leave blank or set to 'mock' for testing simulation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# API URL for Frontend (usually http://localhost:5000/api or /api in production)
VITE_API_BASE_URL=http://localhost:5000/api
